{
  "name": "kitty-event-bus-client",
  "version": "1.5.0",
  "description": "KITTY, CloudEvent NATS Speaker — a Vue 3 feline CNCF CloudEvents consumer & vocalizer, usable as a Vue component, an Astro island, or a plain <script> drop-in.",
  "type": "module",
  "license": "MIT",
  "author": "Infrashift.io",
  "homepage": "https://infrashift.github.io/kitty-event-bus-client/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infrashift/kitty-event-bus-client.git",
    "directory": "kitty"
  },
  "keywords": ["vue", "vue3", "astro", "cloudevents", "nats", "cncf", "cat", "web-audio", "tts"],
  "files": ["dist", "vite-plugin-tts.mjs", "vite-plugin-tts.d.mts"],
  "sideEffects": ["**/*.css"],
  "main": "./dist/kitty-event-bus-client.js",
  "module": "./dist/kitty-event-bus-client.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kitty-event-bus-client.js"
    },
    "./style.css": "./dist/style.css",
    "./standalone": "./dist/kitty-event-bus-client.iife.js",
    "./tts/*": "./dist/tts/*",
    "./vite": {
      "types": "./vite-plugin-tts.d.mts",
      "import": "./vite-plugin-tts.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build:app": "vite build --mode app",
    "build:lib": "vite build --mode lib",
    "build:standalone": "vite build --mode standalone",
    "build:types": "vue-tsc -p tsconfig.lib.json",
    "build": "bun run typecheck && bun run build:lib && bun run build:standalone && bun run build:types",
    "preview": "vite preview --outDir dist-app",
    "test": "playwright test"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
